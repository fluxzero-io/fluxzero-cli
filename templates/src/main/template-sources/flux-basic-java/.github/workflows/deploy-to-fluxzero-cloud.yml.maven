name: Deploy to Fluxzero Cloud

on:
  workflow_dispatch:
    inputs:
      cluster-name:
        description: "Cluster name"
        required: true
        default: "Test"
      application-name:
        description: "Application name"
        required: true
        default: "flux-basic-java"

env:
  FLUXZERO_PACKAGE_NAME: flux-basic-java
  FLUXZERO_PACKAGE_VERSION: sha-${{ github.sha }}

jobs:
  deploy:
    name: Build, publish and deploy
    runs-on: ubuntu-latest

    permissions:
      contents: read
      id-token: write

    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Setup Java
        uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad # v6.1.0
        with:
          distribution: temurin
          java-version: '25'
          cache: maven

      - name: Build and test with Maven
        run: ./mvnw -B -ntp -T1C package

      - name: Publish layered image with the Fluxzero Maven plugin
        run: ./mvnw -B -ntp -Dfluxzero.package.tag="${FLUXZERO_PACKAGE_VERSION}" fluxzero:publish-package

      - name: Authenticate for deployment
        id: fluxzero-auth
        uses: fluxzero-io/fluxzero-jwt-action@73840be3df06c4bcae88804d4789e637e69e1746 # v2.3.1
        with:
          mode: oidc
          image-name: ${{ env.FLUXZERO_PACKAGE_NAME }}

      - name: Deploy to Fluxzero Cloud
        uses: fluxzero-io/fluxzero-deploy-action@dfa1f2ac2a0930ccfa4a32db3f546dc64e22dd45 # v1.1.2
        with:
          cluster-name: ${{ github.event.inputs.cluster-name }}
          application-name: ${{ github.event.inputs.application-name }}
          image-name: ${{ env.FLUXZERO_PACKAGE_NAME }}
          version: ${{ env.FLUXZERO_PACKAGE_VERSION }}
          token: ${{ steps.fluxzero-auth.outputs.deploy-token }}
