{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "ignorePaths": [
    "templates/build/**",
    "**/test/resources/**"
  ],
  "packageRules": [
    {
      "description": "Group all minor and patch updates into a single PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all minor and patch dependencies"
    },
    {
      "description": "Group all major updates into a single PR",
      "matchUpdateTypes": ["major"],
      "groupName": "all major dependencies"
    },
    {
      "description": "Keep all embedded customer templates on one Fluxzero dependency set",
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "io.fluxzero:fluxzero-bom",
        "io.fluxzero.idp:client",
        "io.fluxzero.tools:fluxzero-maven-plugin"
      ],
      "groupName": "Fluxzero customer template dependencies",
      "groupSlug": "fluxzero-customer-template-dependencies"
    },
    {
      "description": "Merge every verified customer template update",
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "io.fluxzero:fluxzero-bom",
        "io.fluxzero.idp:client",
        "io.fluxzero.tools:fluxzero-maven-plugin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update centrally injected Fluxzero customer template versions",
      "fileMatch": ["/^templates\\/template-versions\\.properties$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:\\w+)=(?<currentValue>\\S+)"
      ]
    }
  ],
  "gradle": {
    "fileMatch": [
      "(^|/)build\\.gradle\\.kts$",
      "(^|/)settings\\.gradle\\.kts$"
    ]
  }
}
